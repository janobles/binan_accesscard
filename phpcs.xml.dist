<?xml version="1.0"?>
<ruleset name="Binan">
    <description>
        Catches documentation that contradicts the code: a docblock type that
        disagrees with the signature, a tag naming a parameter that does not
        exist, a return tag the code contradicts, and a docblock that is nothing
        but restated tags. Classes must be documented. Whether a given method
        earns a docblock is decided at review, not here, because a linter can
        see that a docblock exists but never that it is true. See
        docs/knowledge/php-practices/comments.md.
    </description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <file>app/Controllers</file>
    <file>app/Models</file>
    <file>app/Libraries</file>
    <file>app/Support</file>
    <file>app/Helpers</file>
    <file>app/Jobs</file>
    <file>app/Commands</file>
    <file>app/Validation</file>
    <file>app/Filters</file>
    <file>app/Database</file>

    <!-- Stock framework files and data-only files carry no documentation duty. -->
    <exclude-pattern>*/app/Config/*</exclude-pattern>
    <exclude-pattern>*/app/Language/*</exclude-pattern>
    <exclude-pattern>*/app/Common.php</exclude-pattern>
    <exclude-pattern>*/app/Views/*</exclude-pattern>

    <!-- A class must be documented. The tag requirements are dropped: this repo
         does not use @author or @copyright. -->
    <rule ref="Squiz.Commenting.ClassComment">
        <exclude name="Squiz.Commenting.ClassComment.TagNotAllowed"/>
    </rule>

    <!-- A method docblock is validated when one is present; whether a method
         needs one at all is decided at review (see the Missing exclusion at the
         end of this block). @param/@return are only required when they add
         something the signature does not already say. -->
    <rule ref="Squiz.Commenting.FunctionComment">
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamName"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingReturn"/>
        <exclude name="Squiz.Commenting.FunctionComment.ParamNameNoMatch"/>
        <exclude name="Squiz.Commenting.FunctionComment.ScalarTypeHintMissing"/>
        <exclude name="Squiz.Commenting.FunctionComment.TypeHintMissing"/>
        <exclude name="Squiz.Commenting.FunctionComment.InvalidReturnNotVoid"/>
        <exclude name="Squiz.Commenting.FunctionComment.InvalidNoReturn"/>

        <!-- Tag punctuation and alignment are not part of this standard. A tag
             either earns its place by saying something the signature does not,
             or it gets deleted. Whether its description ends in a period is not
             a documentation question. -->
        <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
        <exclude name="Squiz.Commenting.FunctionComment.ParamCommentNotCapital"/>
        <exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamName"/>
        <exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamType"/>
        <exclude name="Squiz.Commenting.FunctionComment.ThrowsNotCapital"/>

        <!-- Positional matching. This sniff pairs the first @param tag with the
             first parameter, so documenting only the one argument that needs
             explaining makes it report a type mismatch that does not exist.
             Selective tagging is the standard here, so this code has to go.
             Accuracy is still covered: IncorrectParamVarName catches a tag
             naming a parameter that is gone, and InvalidReturn catches a return
             tag the code contradicts. -->
        <exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>

        <!-- Presence is a judgment call, not a lint error. A linter can see
             that a docblock exists but never that it is true, so requiring one
             on every method buys filler, not documentation. Whether a method
             earns a docblock is decided at review. What stays enforced below is
             documentation that contradicts the code. -->
        <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
    </rule>

    <!-- The rule that makes "tags only when useful" enforceable rather than
         aspirational: a docblock that only restates the signature is an error. -->
    <!-- Catches a docblock that is nothing but tags restating the signature.
         It does NOT catch a redundant tag inside a docblock that also has
         prose: the sniff bails out once any summary text is present. That
         narrower case is a review matter. See
         docs/knowledge/php-practices/comments.md. -->
    <rule ref="SlevomatCodingStandard.Commenting.UselessFunctionDocComment"/>
    <rule ref="SlevomatCodingStandard.Commenting.DocCommentSpacing"/>

    <rule ref="SlevomatCodingStandard.Commenting.ForbiddenAnnotations">
        <properties>
            <property name="forbiddenAnnotations" type="array">
                <element value="@author"/>
                <element value="@created"/>
                <element value="@version"/>
                <element value="@package"/>
            </property>
        </properties>
    </rule>
</ruleset>
